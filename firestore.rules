rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Helpers =====
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return getUserDoc().data;
    }

    function getUserRole() {
      return getUserData().role;
    }

    // ✅ Hierarchy-aware role checks
    function isAdmin() {
      return isSignedIn() && getUserRole() == "admin";
    }

    function isCoordinator() {
      return isSignedIn() && (
        getUserRole() == "coordinator" ||
        getUserRole() == "admin"
      );
    }

    function isVolunteer() {
      return isSignedIn() && (
        getUserRole() == "volunteer" ||
        getUserRole() == "coordinator" ||
        getUserRole() == "admin"
      );
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ✅ Cases store who's assigned in assigned_volunteer_ids (an array of
    // uids), kept in sync by assignmentService.js whenever an assignment
    // is created or removed — rules can't query the separate
    // "assignments" collection by case_id, so this denormalized array on
    // the case itself is what lets an assigned volunteer close their own
    // case. Guard against the field being absent (e.g. cases created
    // before this field existed, or never assigned) so the check fails
    // closed instead of erroring.
    function isAssignedVolunteer(resource) {
      return resource.data.assigned_volunteer_ids != null
        && request.auth.uid in resource.data.assigned_volunteer_ids;
    }

    // ===== USERS =====
   match /users/{userId} {

    allow get: if isSignedIn();

    // allow listing ONLY for staff (avoids query conflicts)
    allow list: if isCoordinator();

    allow create: if isAdmin();

    allow update: if isAdmin() || isSelf(userId);

    allow delete: if isAdmin();
  }


    // ===== CASES =====
   match /cases/{caseId} {

  allow read: if isSignedIn();

  allow create: if request.resource.data.status == "open";

  allow update: if isAdmin()
    || isCoordinator()
    || (isVolunteer() && isAssignedVolunteer(resource));

  allow delete: if isAdmin();
}


    // ===== ASSIGNMENTS =====
    match /assignments/{assignmentId} {


      allow get, list: if isAdmin()
        || isCoordinator()
        || (isVolunteer() && request.auth.uid != null);


      allow create, update, delete: if isAdmin() || isCoordinator();
    }

    // ===== FEEDBACK =====
    match /feedback/{feedbackId} {

      allow create: if true; // public submission

      allow get, list: if isCoordinator(); // includes admin

      allow update, delete: if false;
    }

    // ===== INTAKE FORMS =====
    match /intakeForms/{formId} {

      allow read, write: if isCoordinator(); // includes admin
    }

    // ===== BLOCK EVERYTHING ELSE =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
