rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Helpers =====
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return getUserDoc().data;
    }

    function getUserRole() {
      return getUserData().role;
    }

    // ✅ Hierarchy-aware role checks
    function isAdmin() {
      return isSignedIn() && getUserRole() == "admin";
    }

    function isCoordinator() {
      return isSignedIn() && (
        getUserRole() == "coordinator" ||
        getUserRole() == "admin"
      );
    }

    function isVolunteer() {
      return isSignedIn() && (
        getUserRole() == "volunteer" ||
        getUserRole() == "coordinator" ||
        getUserRole() == "admin"
      );
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAssignedVolunteer(resource) {
      return resource.data.assignedVolunteer == request.auth.uid;
    }

    // ===== USERS =====
   match /users/{userId} {

    allow get: if isSignedIn();

    // allow listing ONLY for staff (avoids query conflicts)
    allow list: if isCoordinator();

    allow create: if isAdmin();

    allow update: if isAdmin() || isSelf(userId);

    allow delete: if isAdmin();
  }


    // ===== CASES =====
   match /cases/{caseId} {

  allow get: if isAdmin()
    || isCoordinator()
    || (isVolunteer() && isAssignedVolunteer(resource));

  //  IMPORTANT: allow all staff to list
  allow list: if isVolunteer();

  allow create: if request.resource.data.status == "open";

  allow update: if isAdmin()
    || isCoordinator()
    || (isVolunteer() && isAssignedVolunteer(resource));

  allow delete: if isAdmin();
}


    // ===== ASSIGNMENTS =====
    match /assignments/{assignmentId} {

      allow get, list: if isAdmin()
        || isCoordinator()
        || (isVolunteer() && resource.data.user_id == request.auth.uid);

      allow create, update, delete: if isAdmin() || isCoordinator();
    }

    // ===== FEEDBACK =====
    match /feedback/{feedbackId} {

      allow create: if true; // public submission

      allow get, list: if isCoordinator(); // includes admin

      allow update, delete: if false;
    }

    // ===== INTAKE FORMS =====
    match /intakeForms/{formId} {

      allow read, write: if isCoordinator(); // includes admin
    }

    // ===== BLOCK EVERYTHING ELSE =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}